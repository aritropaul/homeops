HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info
NODE_ENV=production

HOMEOPS_KEY=

SMARTRENT_EMAIL=
SMARTRENT_PASSWORD=
SMARTRENT_UNIT_ID=

LOCK_ID=
THERMOSTAT_B1_ID=
THERMOSTAT_B2_ID=
THERMOSTAT_B3_ID=

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

POLL_SECONDS=30
AUTOLOCK_MINUTES=10

# ── Comfort engine (B2) ───────────────────────────────────────────────────────
# The engine has no "season". Each context defines a comfort range; the engine
# picks heat / cool / off from the real room temperature + outdoor weather.

# Location for outdoor weather (Open-Meteo, no API key). Leave blank to disable
# the weather layer — the engine still works off the indoor reading alone.
LATITUDE=
LONGITUDE=

# Autonomously hold B2 to the comfort range on every poll tick. Set false to
# only act on explicit /arrive /leave /arriving /sleep calls.
ENABLE_COMFORT_AUTO=true

# Comfort ranges: engine idles inside [LOW, HIGH], conditions to the center.
COMFORT_HOME_LOW_F=68
COMFORT_HOME_HIGH_F=72
COMFORT_SLEEP_LOW_F=65
COMFORT_SLEEP_HIGH_F=70

# Away coast band: only act at these extremes. Ceiling auto-tightens on hot days.
COMFORT_AWAY_MIN_F=60
COMFORT_AWAY_MAX_F=82

# Sleep window (24h local clock), anti-chatter margin, command spacing, override.
COMFORT_SLEEP_START_HOUR=22
COMFORT_SLEEP_END_HOUR=7
COMFORT_DEADBAND_F=0.5
COMFORT_CONTROL_MIN_MINUTES=5
COMFORT_OVERRIDE_TTL_MINUTES=120

# Forecast highs at/above these tighten the away ceiling (80°F / 78°F).
COMFORT_HOT_FORECAST_F=90
COMFORT_VERY_HOT_FORECAST_F=95

# Humidity → "feels like" model (kicks in above the reference temp).
COMFORT_HUMIDITY_REF_TEMP_F=74
COMFORT_HUMIDITY_REF_PCT=50
COMFORT_HUMIDITY_PER_PCT_F=0.1
COMFORT_HUMIDITY_CAP_F=3

# PREHEAT_MODE is now only the fallback mode for manual /thermostat sets.
PREHEAT_MODE=heat
