HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info
NODE_ENV=production

HOMEOPS_KEY=

SMARTRENT_EMAIL=
SMARTRENT_PASSWORD=
SMARTRENT_UNIT_ID=

LOCK_ID=
THERMOSTAT_B1_ID=
THERMOSTAT_B2_ID=
THERMOSTAT_B3_ID=

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

POLL_SECONDS=30
AUTOLOCK_MINUTES=10

# Mode used when /thermostat/:name/:temp doesn't specify one.
# (PREHEAT_MODE is still honoured for backwards compatibility.)
DEFAULT_THERMOSTAT_MODE=heat
